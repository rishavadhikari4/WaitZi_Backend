// WaitZi data model (PostgreSQL). See PLATFORM_PLAN.md.
//
// Tenancy: every tenant-owned table carries org_id and is protected by
// row-level security (see migrations/*_rls). Never query tenant tables outside
// withTenant() / asPlatform() in db/client.js.
//
// Money is stored as integer paisa (Rs 1 = 100) to avoid float rounding.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform & tenancy ----------

enum OrgStatus {
  trial
  active
  suspended

  @@map("org_status")
}

enum DomainType {
  subdomain
  custom

  @@map("domain_type")
}

enum UserScope {
  platform
  tenant

  @@map("user_scope")
}

enum PlatformRole {
  super_admin
  platform_admin

  @@map("platform_role")
}

enum ActiveStatus {
  Active
  Inactive

  @@map("active_status")
}

model Organization {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  slug        String    @unique
  status      OrgStatus @default(trial)
  plan        String    @default("starter")
  branding    Json      @default("{}")
  taxSettings Json      @default("{\"vatRate\": 13, \"serviceChargeRate\": 10}") @map("tax_settings")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  branches    Branch[]
  domains     Domain[]
  memberships Membership[]
  roles       Role[]
  categories  Category[]
  menuItems   MenuItem[]
  tables      DiningTable[]
  orders      Order[]
  orderItems  OrderItem[]
  payments    Payment[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Branch {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Kathmandu")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tables   DiningTable[]
  orders   Order[]
  payments Payment[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("branches")
}

model Domain {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  hostname    String     @unique
  type        DomainType
  verifyToken String     @map("verify_token")
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz
  tlsStatus   String     @default("pending") @map("tls_status")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("domains")
}

/// A login identity. One person can work at several organizations through
/// memberships, so users have no org_id; visibility is enforced by RLS via
/// memberships (see the RLS migration).
model User {
  id                   String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  address              String?
  phone                String        @unique
  email                String        @unique
  image                String?
  imageId              String?       @map("image_id")
  passwordHash         String        @map("password_hash")
  scope                UserScope     @default(tenant)
  platformRole         PlatformRole? @map("platform_role")
  status               ActiveStatus  @default(Active)
  resetPasswordToken   String?       @map("reset_password_token")
  resetPasswordExpires DateTime?     @map("reset_password_expires") @db.Timestamptz
  passwordChangedAt    DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz
  mustChangePassword   Boolean       @default(false) @map("must_change_password")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  memberships     Membership[]
  assignedTables  DiningTable[] @relation("TableWaiter")
  ordersAssigned  Order[]       @relation("OrderWaiter")
  ordersCooked    Order[]       @relation("OrderCook")
  ordersServed    Order[]       @relation("OrderServer")
  paymentsHandled Payment[]

  @@index([firstName, lastName])
  @@map("users")
}

/// Roles are named permission sets owned by an organization. Platform roles
/// live on User.platformRole instead, so org_id is always set here.
model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([orgId, name])
  @@map("roles")
}

model Membership {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  roleId    String       @map("role_id") @db.Uuid
  /// Empty = all branches of the org.
  branchIds String[]     @default([]) @map("branch_ids") @db.Uuid
  status    ActiveStatus @default(Active)
  pinHash   String?      @map("pin_hash")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------- Restaurant (ported from the Mongo collections) ----------

enum MenuAvailability {
  Available
  OutOfStock @map("Out of Stock")

  @@map("menu_availability")
}

enum TableStatus {
  Available
  Occupied
  Reserved

  @@map("table_status")
}

enum OrderStatus {
  Pending
  InKitchen
  Served
  Cancelled
  Paid
  Completed

  @@map("order_status")
}

enum OrderItemStatus {
  Pending
  Cooking
  Ready
  Served

  @@map("order_item_status")
}

enum PaymentMethod {
  Cash
  Card
  Fonepay
  NepalPay
  Khalti

  @@map("payment_method")
}

enum PaymentStatus {
  Paid
  Pending
  Failed
  Refunded

  @@map("payment_status")
}

model Category {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  image       String?
  imageId     String?  @map("image_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("categories")
}

model MenuItem {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String           @map("org_id") @db.Uuid
  categoryId         String           @map("category_id") @db.Uuid
  name               String
  pricePaisa         Int              @map("price_paisa")
  description        String?
  image              String?
  imageId            String?          @map("image_id")
  availabilityStatus MenuAvailability @default(Available) @map("availability_status")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([orgId, categoryId, availabilityStatus])
  @@index([orgId, name])
  @@map("menu_items")
}

model DiningTable {
  id               String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  tableNumber      Int         @map("table_number")
  capacity         Int
  status           TableStatus @default(Available)
  /// Unguessable token printed in the table QR (replaces /table/:number).
  qrToken          String      @unique @default(dbgenerated("encode(gen_random_bytes(16), 'hex')")) @map("qr_token")
  currentOrderId   String?     @unique @map("current_order_id") @db.Uuid
  assignedWaiterId String?     @map("assigned_waiter_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentOrder   Order?       @relation("TableCurrentOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)
  assignedWaiter User?        @relation("TableWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  orders         Order[]      @relation("TableOrders")
  payments       Payment[]

  @@unique([branchId, tableNumber])
  @@index([orgId, branchId, status])
  @@map("dining_tables")
}

model Order {
  id               String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  tableId          String      @map("table_id") @db.Uuid
  customerName     String      @map("customer_name")
  totalPaisa       Int         @default(0) @map("total_paisa")
  discountPaisa    Int         @default(0) @map("discount_paisa")
  finalPaisa       Int         @default(0) @map("final_paisa")
  status           OrderStatus @default(Pending)
  assignedWaiterId String?     @map("assigned_waiter_id") @db.Uuid
  orderTimeout     DateTime    @default(dbgenerated("(now() + interval '30 minutes')")) @map("order_timeout") @db.Timestamptz
  isTimedOut       Boolean     @default(false) @map("is_timed_out")
  isPrepaid        Boolean     @default(false) @map("is_prepaid")
  note             String?
  cookedById       String?     @map("cooked_by_id") @db.Uuid
  servedById       String?     @map("served_by_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table          DiningTable  @relation("TableOrders", fields: [tableId], references: [id], onDelete: Restrict)
  assignedWaiter User?        @relation("OrderWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  cookedBy       User?        @relation("OrderCook", fields: [cookedById], references: [id], onDelete: SetNull)
  servedBy       User?        @relation("OrderServer", fields: [servedById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  currentAtTable DiningTable? @relation("TableCurrentOrder")

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, status])
  @@index([tableId, status])
  @@map("orders")
}

/// Line items are snapshotted (name, price) so menu edits never rewrite history.
model OrderItem {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  menuItemId    String          @map("menu_item_id") @db.Uuid
  name          String
  quantity      Int
  pricePaisa    Int             @map("price_paisa")
  subtotalPaisa Int             @map("subtotal_paisa")
  status        OrderItemStatus @default(Pending)
  notes         String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orgId, status])
  @@map("order_items")
}

/// Kept 1:1 with the old Payment collection for the port; Stage 4 replaces it
/// with an append-only transactions ledger.
model Payment {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String        @map("org_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  tableId       String?       @map("table_id") @db.Uuid
  amountPaisa   Int           @map("amount_paisa")
  method        PaymentMethod
  status        PaymentStatus @default(Pending)
  handledById   String?       @map("handled_by_id") @db.Uuid
  transactionId String?       @map("transaction_id")
  khaltiPidx    String?       @unique @map("khalti_pidx")
  paymentTime   DateTime      @default(now()) @map("payment_time") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  table     DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  handledBy User?        @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([orgId, paymentTime(sort: Desc)])
  @@index([orderId])
  @@index([orgId, status, method])
  @@map("payments")
}
