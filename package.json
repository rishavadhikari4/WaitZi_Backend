{
  "name": "waitzi_backend",
  "version": "1.0.0",
  "type": "module",
  "description": "This is the backend For a digial waiter and restaurant management system",
  "main": "server.ts",
  "scripts": {
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx watch --clear-screen=false server.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishavadhikari4/WaitZi_Backend.git"
  },
  "author": "Rishav Adhikari",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rishavadhikari4/WaitZi_Backend/issues"
  },
  "homepage": "https://github.com/rishavadhikari4/WaitZi_Backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.11",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
