# --- PostgreSQL (dev: `npm run db:up`, Postgres 18 on localhost:5434) ---
# Owner role: migrations only (prisma.config.js)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5434/waitzi
# Least-privilege app role: row-level security applies (db/client.js withTenant)
DATABASE_URL=postgresql://waitzi_app:waitzi_app_dev@localhost:5434/waitzi
# BYPASSRLS role: platform tools and background jobs only (db/client.js asPlatform)
DATABASE_PLATFORM_URL=postgresql://waitzi_platform:waitzi_platform_dev@localhost:5434/waitzi

# --- Legacy MongoDB (until Stage 1 finishes porting the API) ---
MONGO_URI=

# --- Auth ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Khalti (moves to per-organization settings in Stage 4) ---
KHALTI_GATEWAY_URL=https://dev.khalti.com
KHALTI_SECRET_KEY=
KHALTI_RETURN_URL=
KHALTI_WEBSITE_URL=
