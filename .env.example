# --- PostgreSQL (dev: `npm run db:up`, Postgres 18 on localhost:5434) ---
# Owner role: migrations only (prisma.config.js)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5434/waitzi
# Least-privilege app role: row-level security applies (db/client.js withTenant)
DATABASE_URL=postgresql://waitzi_app:waitzi_app_dev@localhost:5434/waitzi
# BYPASSRLS role: platform tools and background jobs only (db/client.js asPlatform)
DATABASE_PLATFORM_URL=postgresql://waitzi_platform:waitzi_platform_dev@localhost:5434/waitzi

# --- Legacy MongoDB (until Stage 1 finishes porting the API) ---
MONGO_URI=

# --- App ---
PORT=8080
# Public URL of this API (Khalti redirects guests back to it)
API_URL=http://localhost:8080
# Comma-separated frontend origins; the first is used in QR links and emails
FRONTEND_URL=http://localhost:3000
# Org used for guest links that carry no org (old number-only QR stickers),
# and the only org allowed to use the env Khalti keys until Stage 4
DEFAULT_ORG_SLUG=
# Orders
KITCHEN_CAPACITY=10
ORDER_TIMEOUT_MINUTES=30

# --- Auth ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Khalti (moves to per-organization settings in Stage 4) ---
# KHALTI_RETURN_URL must now point at <API_URL>/api/public/payments/khalti/callback
KHALTI_GATEWAY_URL=https://dev.khalti.com
KHALTI_SECRET_KEY=
KHALTI_RETURN_URL=
KHALTI_WEBSITE_URL=
